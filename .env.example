# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# AI behavior
# When true, API calls return deterministic mock responses if no API key is available.
ALLOW_MOCK_AI=true

# OpenAI-compatible providers. These names match the apiKeyRef configured in the UI.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
PRIVATE_LLM_API_KEY=

# Metadata/database credentials should stay server-side.
DW_METADATA_PASSWORD=
